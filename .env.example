# Fitted Virtual Try-On Environment Variables

# Demo Mode (defaults to true if no Replicate token is set)
NEXT_PUBLIC_DEMO_MODE=true

# Replicate API Credentials (optional for live GPU model inference)
REPLICATE_API_TOKEN=

# Supabase Credentials (optional - falls back to robust local/offline storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
